{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scope.local/schemas/worker-result.schema.json",
  "title": "Scope worker result v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "status",
    "summary",
    "changed_paths",
    "validations",
    "questions",
    "issues",
    "payload"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "job_id": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["completed", "needs_user", "blocked", "failed"]},
    "summary": {"type": "string", "minLength": 1},
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "validations": {
      "type": "array",
      "items": {"$ref": "#/$defs/validation"}
    },
    "questions": {
      "type": "array",
      "items": {"$ref": "#/$defs/question"}
    },
    "issues": {
      "type": "array",
      "items": {"$ref": "#/$defs/issue"}
    },
    "payload": {
      "anyOf": [
        {"$ref": "#/$defs/refinement_payload"},
        {"$ref": "#/$defs/implementation_payload"},
        {"$ref": "#/$defs/diagnostic_payload"}
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "summary"],
      "properties": {
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "summary": {"type": "string", "minLength": 1}
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "reason", "evidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "message", "evidence"],
      "properties": {
        "severity": {"type": "string", "enum": ["blocking", "major", "minor"]},
        "message": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "refinement_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "authored_artifacts", "decision_refs"],
      "properties": {
        "kind": {"type": "string", "const": "refinement"},
        "authored_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "decision_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "proof_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proof_id",
        "command",
        "exit_code",
        "passed",
        "failed",
        "errors",
        "skipped",
        "evidence_path",
        "evidence_sha256"
      ],
      "properties": {
        "proof_id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "exit_code": {"type": "integer"},
        "passed": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0},
        "errors": {"type": "integer", "minimum": 0},
        "skipped": {"type": "integer", "minimum": 0},
        "evidence_path": {"type": "string", "minLength": 1},
        "evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "implementation_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "notes", "proof_evidence"],
      "properties": {
        "kind": {"type": "string", "const": "implementation"},
        "notes": {"type": "string"},
        "proof_evidence": {
          "type": "array",
          "items": {"$ref": "#/$defs/proof_evidence"}
        }
      }
    },
    "diagnostic_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "cause", "evidence", "recommended_action"],
      "properties": {
        "kind": {"type": "string", "const": "diagnostic"},
        "cause": {"type": "string"},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "recommended_action": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"type": "string", "const": "needs_user"}}, "required": ["status"]},
      "then": {"properties": {"questions": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"status": {"type": "string", "enum": ["blocked", "failed"]}}, "required": ["status"]},
      "then": {
        "properties": {
          "issues": {
            "contains": {
              "type": "object",
              "properties": {"severity": {"type": "string", "const": "blocking"}},
              "required": ["severity"]
            }
          }
        }
      }
    }
  ]
}
