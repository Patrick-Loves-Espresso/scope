{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://scope.local/schemas/worker-job.schema.json",
  "title": "Scope worker job v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "command",
    "role",
    "phase",
    "epic_id",
    "repository_root",
    "working_root",
    "scope_root",
    "read_scope",
    "write_scope",
    "artifacts",
    "decision_refs",
    "required_validations",
    "required_proof_ids",
    "result_path"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "command": {"enum": ["epic_refine", "implement", "audit_epic"]},
    "role": {"enum": ["refinement", "implementation", "diagnostic"]},
    "phase": {
      "enum": [
        "product",
        "design_handoff",
        "correction",
        "story",
        "audit_remediation",
        "debugging",
        "investigate"
      ]
    },
    "epic_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "repository_root": {"type": "string", "minLength": 1},
    "working_root": {"type": "string", "minLength": 1},
    "scope_root": {"type": "string", "minLength": 1},
    "read_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "write_scope": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "sha256"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "required_validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "purpose"],
        "properties": {
          "command": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_proof_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "story_ids": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "allowed_commands": {
      "type": "array", "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "implementation_evidence_path": {"type": "string", "minLength": 1},
    "result_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"role": {"const": "refinement"}}, "required": ["role"]},
      "then": {
        "properties": {
          "command": {"const": "epic_refine"},
          "phase": {"enum": ["product", "design_handoff", "correction"]},
          "required_proof_ids": {"maxItems": 0}
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "implementation"}}, "required": ["role"]},
      "then": {
        "required": ["implementation_evidence_path"],
        "properties": {
          "command": {"const": "implement"},
          "phase": {
            "enum": ["story", "audit_remediation", "debugging"]
          }
        }
      }
    },
    {
      "if": {"properties": {"role": {"const": "diagnostic"}}, "required": ["role"]},
      "then": {
        "properties": {
          "command": {"enum": ["epic_refine", "implement", "audit_epic"]},
          "phase": {"const": "investigate"},
          "write_scope": {"maxItems": 0},
          "required_validations": {"maxItems": 0},
          "required_proof_ids": {"maxItems": 0}
        }
      }
    }
  ]
}
